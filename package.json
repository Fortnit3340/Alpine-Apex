{
  "name": "alpine-apex-duel",
  "version": "1.0.0",
  "description": "ALPINE APEX \u2014 scenic racing and online duels",
  "author": "ALPINE APEX",
  "license": "UNLICENSED",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis",
    "dist:linux": "electron-builder --linux AppImage",
    "dist:mac": "electron-builder --mac dmg"
  },
  "devDependencies": {
    "electron": "34.5.8",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.alpineapex.duel",
    "productName": "ALPINE APEX Duel",
    "directories": {
      "output": "dist"
    },
    "files": [
      "game.html",
      "cloud-config.js",
      "main.cjs",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "ALPINE-APEX-Duel-Setup-${version}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "artifactName": "ALPINE-APEX-Duel-${version}.${ext}"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "artifactName": "ALPINE-APEX-Duel-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
